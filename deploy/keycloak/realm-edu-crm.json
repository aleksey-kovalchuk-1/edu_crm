{
  "realm": "edu-crm",
  "displayName": "Образование CRM",
  "displayNameHtml": "Образование CRM",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "verifyEmail": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ru"
  ],
  "defaultLocale": "ru",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "smtpServer": {
    "host": "${SMTP_HOST:mailpit}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:noreply@educrm-demo.ru}",
    "fromDisplayName": "Образование CRM",
    "ssl": "${SMTP_SSL:false}",
    "starttls": "${SMTP_STARTTLS:false}",
    "auth": "${SMTP_AUTH:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}"
  },
  "loginTheme": "edu-crm",
  "roles": {
    "realm": [
      {
        "name": "crm-user",
        "description": "Менеджер ключевых клиентов: видит и редактирует закреплённые за ним вузы"
      },
      {
        "name": "crm-supervisor",
        "description": "Руководитель: видит все вузы и переназначает ответственных"
      },
      {
        "name": "crm-admin",
        "description": "Администратор: видит все данные и управляет доступом"
      },
      {
        "name": "default-roles-edu-crm",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "crm-user"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "edu-crm-api",
      "name": "Образование CRM",
      "description": "Серверный OIDC-клиент CRM (backend-for-frontend)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EDU_CRM_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "rootUrl": "",
      "baseUrl": "",
      "redirectUris": [
        "http://localhost:8080/api/v1/auth/callback",
        "http://localhost:5173/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "anna.demo",
      "firstName": "Анна",
      "lastName": "Демо",
      "email": "anna.demo@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${EDU_CRM_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-edu-crm",
        "crm-user"
      ]
    },
    {
      "username": "pavel.demo",
      "firstName": "Павел",
      "lastName": "Демо",
      "email": "pavel.demo@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${EDU_CRM_DEMO_SUPERVISOR_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-edu-crm",
        "crm-supervisor"
      ]
    },
    {
      "username": "irina.demo",
      "firstName": "Ирина",
      "lastName": "Демо",
      "email": "irina.demo@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${EDU_CRM_DEMO_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-edu-crm",
        "crm-admin"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}, \"pattern\": {\"pattern\": \"^[^@\\\\s]+@[^@\\\\s]+\\\\.ru$\", \"error-message\": \"emailRuOnly\"}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "authenticationFlows": [
    {
      "alias": "registration-with-recaptcha",
      "description": "Форма регистрации CRM с обязательной проверкой reCAPTCHA (D-158)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-page-form",
          "authenticatorFlow": true,
          "requirement": "REQUIRED",
          "priority": 10,
          "flowAlias": "registration-with-recaptcha form",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "registration-with-recaptcha form",
      "description": "Форма регистрации CRM с обязательной проверкой reCAPTCHA (D-158)",
      "providerId": "form-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "registration-user-creation",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-password-action",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 50,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-recaptcha-action",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 60,
          "userSetupAllowed": false
        },
        {
          "authenticator": "registration-terms-and-conditions",
          "authenticatorFlow": false,
          "requirement": "DISABLED",
          "priority": 70,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "registrationFlow": "registration-with-recaptcha"
}
