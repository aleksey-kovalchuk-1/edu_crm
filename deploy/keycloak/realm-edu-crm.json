{
  "realm": "edu-crm",
  "displayName": "UniCRM",
  "displayNameHtml": "UniCRM",
  "loginTheme": "edu-crm",
  "emailTheme": "edu-crm",
  "actionTokenGeneratedByUserLifespan": 43200,
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["ru", "en"],
  "defaultLocale": "ru",
  "bruteForceProtected": true,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": ["jboss-logging"],
  "enabledEventTypes": ["LOGIN", "LOGIN_ERROR", "LOGOUT", "UPDATE_PASSWORD"],
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "crm-user",
        "description": "Менеджер: работает с десятью общими вузами и закреплёнными за ним вузами"
      },
      {
        "name": "crm-supervisor",
        "description": "Руководитель: видит все вузы и переназначает ответственных"
      },
      {
        "name": "crm-admin",
        "description": "Администратор: видит все вузы и рабочие данные; создание аккаунтов доступно только главному администратору"
      },
      {
        "name": "crm-superadmin",
        "composite": true,
        "composites": { "realm": ["crm-admin", "crm-supervisor"] },
        "description": "Полный административный доступ: пользователи, роли, безопасность, конфигурация системы"
      }
    ]
  },
  "clients": [
    {
      "clientId": "edu-crm-api",
      "name": "UniCRM",
      "description": "Серверный OIDC-клиент CRM (backend-for-frontend)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EDU_CRM_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "consentRequired": false,
      "fullScopeAllowed": true,
      "rootUrl": "",
      "baseUrl": "",
      "redirectUris": [
        "http://localhost:8080/api/v1/auth/callback",
        "http://localhost:5173/api/v1/auth/callback",
        "https://unicrm.tech/api/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "https://unicrm.tech"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:5173/*##https://unicrm.tech/*",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "backchannel.logout.session.required": "true",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": ["web-origins", "acr", "basic", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "realm-roles-flat",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "edu-crm-admin",
      "name": "UniCRM — административный доступ",
      "description": "Служебная учётная запись для Keycloak Admin API (список пользователей, роли, политика паролей)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EDU_CRM_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "manager_1",
      "firstName": "Менеджер",
      "lastName": "1",
      "email": "manager_1@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${EDU_CRM_MANAGER_1_PASSWORD}", "temporary": true }
      ],
      "realmRoles": ["default-roles-edu-crm", "crm-user"]
    },
    {
      "username": "manager_2",
      "firstName": "Менеджер",
      "lastName": "2",
      "email": "manager_2@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${EDU_CRM_MANAGER_2_PASSWORD}", "temporary": true }
      ],
      "realmRoles": ["default-roles-edu-crm", "crm-user"]
    },
    {
      "username": "irina_super_admin",
      "firstName": "Ирина",
      "lastName": "Руководитель",
      "email": "irina_super_admin@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${EDU_CRM_IRINA_PASSWORD}", "temporary": true }
      ],
      "realmRoles": ["default-roles-edu-crm", "crm-superadmin"]
    },
    {
      "username": "admin_1",
      "firstName": "Администратор",
      "lastName": "1",
      "email": "admin_1@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${EDU_CRM_ADMIN_1_PASSWORD}", "temporary": true }
      ],
      "realmRoles": ["default-roles-edu-crm", "crm-admin"]
    },
    {
      "username": "admin_2",
      "firstName": "Администратор",
      "lastName": "2",
      "email": "admin_2@educrm-demo.ru",
      "emailVerified": true,
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${EDU_CRM_ADMIN_2_PASSWORD}", "temporary": true }
      ],
      "realmRoles": ["default-roles-edu-crm", "crm-admin"]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": ["{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}, \"pattern\": {\"pattern\": \"^[^@\\\\s]+@[^@\\\\s]+\\\\.[rR][uU]$\", \"error-message\": \"Укажите адрес электронной почты в домене .ru, например ivanov@mail.ru.\"}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"middleName\", \"displayName\": \"Отчество\", \"validations\": {\"length\": {\"max\": 100}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"]
        }
      }
    ]
  }
}
