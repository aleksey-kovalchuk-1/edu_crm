# Demonstration defaults; ports are bound to localhost only.
POSTGRES_PASSWORD=local-demo-only
SEED_DEMO=true
# Number of API worker processes.
WEB_CONCURRENCY=4
# Optional: on container start, grants crm-superadmin once to this Keycloak user's email if no
# superadmin exists yet. Unset by default (nothing is granted).
# INITIAL_SUPERADMIN_EMAIL=irina.demo@demo.local
# Required only for optional Superset. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SUPERSET_SECRET_KEY=

# Keycloak and API secrets (client secret, demo user passwords, session encryption key) are NOT set here.
# Generate them once with scripts/generate-dev-secrets.sh; they are written to deploy/local/*.env, which git ignores.
